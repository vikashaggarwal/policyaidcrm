# Copy to .env.local for local work. Never commit real values.
# On Vercel, set these three in Project Settings -> Environment Variables.

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "publishable" (anon) key. Safe for the browser; protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# SECRET. Server only. Never prefix with NEXT_PUBLIC_. Used only by admin user management and the seed script.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Logins are typed as an ID (caller07); Supabase needs an email, so we use caller07@THIS-DOMAIN.
# No mail is ever sent. Use a domain you own. Set once, before creating users; do not change later.
NEXT_PUBLIC_LOGIN_DOMAIN=yourcompany.in

# Seed script only (npm run seed). Choose your own admin login and a strong password.
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=
